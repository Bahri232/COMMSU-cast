// ComSSUCast Windows Resource Script
#include <windows.h>

// Application Icon
IDI_APP_ICON ICON "resources/icons/app_icon.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Computer Science Students' Society (ComSSU) - UniMak\0"
            VALUE "FileDescription",  "ComSSU Wireless Display System\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "ComSSUCast\0"
            VALUE "LegalCopyright",   "\xA9 2026-2027 Abdul Malik Barrie\0"
            VALUE "OriginalFilename", "ComSSUCast.exe\0"
            VALUE "ProductName",      "ComSSU Cast\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
